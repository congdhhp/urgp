# ─────────────────────────────────────────────────────────────
# URGP Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# All variables use the URGP_ prefix.
# ─────────────────────────────────────────────────────────────

# Application
URGP_ENVIRONMENT=development
URGP_DEBUG=true
URGP_LOG_LEVEL=DEBUG
URGP_LOG_FORMAT=console

# Database (PostgreSQL)
URGP_DATABASE_URL=postgresql+asyncpg://urgp:urgp_dev_password@localhost:5432/urgp
URGP_DATABASE_POOL_SIZE=10

# Message Broker (RabbitMQ)
URGP_RABBITMQ_URL=amqp://urgp:urgp_dev_password@localhost:5672/

# Cache (Redis)
URGP_REDIS_URL=redis://localhost:6379/0

# Security (CHANGE THESE IN PRODUCTION!)
URGP_JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-must-be-32-chars
URGP_SIGNING_KEY=dev-signing-key-for-hmac-change-in-production-32ch
URGP_API_KEYS=["dev-ingest-api-key-change-me"]
URGP_IDEMPOTENCY_TTL_SECONDS=86400
URGP_IDEMPOTENCY_PENDING_TTL_SECONDS=120

# Notifications (MailHog in dev)
URGP_SMTP_HOST=localhost
URGP_SMTP_PORT=1025
URGP_SMTP_FROM=urgp-dev@example.com

# Rate Limiting
URGP_RATE_LIMIT_READ=100
URGP_RATE_LIMIT_WRITE=20
URGP_VALIDATION_DLQ_MAX_BODY_BYTES=65536

# CORS
URGP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
URGP_PORTAL_BASE_URL=http://localhost:5173

# Server
URGP_HOST=0.0.0.0
URGP_PORT=8000
