# URGP backend image: FastAPI API + worker runtime.

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

RUN pip install poetry==1.8.5 && \
    poetry config virtualenvs.create false

COPY backend/pyproject.toml backend/poetry.lock* ./

RUN poetry install --no-interaction --no-ansi --no-root --only main || \
    poetry install --no-interaction --no-ansi --no-root

COPY backend/src/ ./src/

RUN poetry install --no-interaction --no-ansi --only-root

FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

RUN groupadd --gid 1000 urgp && \
    useradd --uid 1000 --gid urgp --shell /bin/bash --create-home urgp

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY backend/src/ ./src/
COPY backend/alembic.ini ./
COPY backend/migrations/ ./migrations/

RUN chown -R urgp:urgp /app

USER urgp

EXPOSE 8000

CMD ["uvicorn", "urgp.main:app", "--host", "0.0.0.0", "--port", "8000"]
